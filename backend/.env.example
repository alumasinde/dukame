ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_BYTES=32
DEFAULT_PLAN_SLUG=free
MEDIA_ROOT=uploads
MEDIA_MAX_BYTES=5242880
CART_SESSION_TTL_SECONDS=2592000
CART_ITEM_MAX_QUANTITY=1000
SMS_PROVIDER=none
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
