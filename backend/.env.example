ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_BYTES=32
DEFAULT_PLAN_SLUG=free
MEDIA_ROOT=uploads
MEDIA_MAX_BYTES=5242880
CART_SESSION_TTL_SECONDS=2592000
CART_ITEM_MAX_QUANTITY=1000
PUBLIC_API_BASE_URL=http://dukamedev.local:8000
# Primary merchant app URL. It is automatically allowed by the API CORS policy.
FRONTEND_BASE_URL=http://dukamedev.local:4173
# Optional JSON list of additional browser origins, for example: ["https://admin.example.com"]
CORS_ORIGINS=[]
PAYMENT_ENCRYPTION_KEY=
SMS_PROVIDER=none
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
