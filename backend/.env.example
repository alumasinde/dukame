WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_REQUIRE_OPT_IN=true
NOTIFICATION_POLL_SECONDS=2
NOTIFICATION_MAX_ATTEMPTS=5
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
