# The one local browser URL. Vite derives its hostname and port from this value.
VITE_APP_URL=http://dukamedev.local:4173
# Browser requests use this relative path; Vite proxies it to DEV_API_PROXY_TARGET locally.
VITE_API_BASE_URL=/api/v1
DEV_API_PROXY_TARGET=http://localhost:8000
# Application branding used by the business-facing UI. Leave empty to use defaults.
VITE_APP_NAME=
VITE_APP_TAGLINE=
# Optional override for a separately hosted storefront. Defaults to VITE_APP_URL.
VITE_STOREFRONT_BASE_URL=
